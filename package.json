{
  "name": "whatsapp-ai-saas-bot-platform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:frontend": "vite",
    "dev:backend": "cd backend && npm run dev",
    "db:migrate": "cd backend && npx prisma migrate deploy",
    "db:seed": "cd backend && npm run seed",
    "prisma:generate": "prisma generate --schema backend/prisma/schema.prisma",
    "vercel-build": "npm run prisma:generate && prisma migrate deploy --schema backend/prisma/schema.prisma && npm run build",
    "postinstall": "npm run prisma:generate",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@google/genai": "^1.41.0",
    "@prisma/client": "^6.19.2",
    "bcryptjs": "^3.0.3",
    "prisma": "^6.19.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
