generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Tenant {
  id             String                @id @default(cuid())
  name           String
  industry       String                @default("Automotriz")
  users          User[]
  leads          Lead[]
  messages       ConversationMessage[]
  workOrders     WorkOrder[]
  knowledgeBase  KnowledgeBase?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
}

model User {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  email     String
  role      String
  passwordHash String?
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, email])
}

model Lead {
  id              String                @id @default(cuid())
  tenantId        String
  name            String
  phone           String
  email           String?
  status          String                @default("Nuevo")
  assignedAgentId String?
  aiSummary       String?
  lastMessageAt   DateTime?
  tenant          Tenant                @relation(fields: [tenantId], references: [id])
  vehicles        Vehicle[]
  messages        ConversationMessage[]
  workOrders      WorkOrder[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([tenantId, phone])
}

model Vehicle {
  id        String   @id @default(cuid())
  leadId    String
  brand     String
  model     String
  plate     String
  year      Int?
  color     String?
  lead      Lead     @relation(fields: [leadId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ConversationMessage {
  id        String   @id @default(cuid())
  tenantId  String
  leadId    String
  direction String
  channel   String
  text      String
  timestamp DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  lead      Lead     @relation(fields: [leadId], references: [id])
}

model WorkOrder {
  id            String   @id @default(cuid())
  tenantId      String
  leadId        String
  serviceType   String
  status        String
  estimatedCost Float
  scheduledAt   DateTime?
  notes         String?
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  lead          Lead     @relation(fields: [leadId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model KnowledgeBase {
  id        String   @id @default(cuid())
  tenantId  String   @unique
  content   String
  metadata  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
